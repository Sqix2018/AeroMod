{
  "name": "aerox-tas",
  "version": "0.1.3",
  "description": "AeroMod - TAS and practice toolkit for Aerox 1.9.5 (iOS), injected with Frida",
  "private": true,
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File tools/bundle.ps1",
    "build:frida": "frida-compile src/index.js -o dist/aerox-tas.js",
    "watch": "frida-compile src/index.js -o dist/aerox-tas.js -w"
  },
  "devDependencies": {
    "@types/frida-gum": "^18.7.1",
    "frida-compile": "^16.4.1"
  }
}
